# Copy this file to ".env" and fill in real values. Never commit the real .env file.

PORT=5000

# RECOMMENDED METHOD — avoids private key formatting problems entirely:
# 1. Firebase Console > Project Settings > Service Accounts > Generate new private key
# 2. Save the downloaded JSON file somewhere OUTSIDE your git repo, e.g. right next
#    to (not inside) your project folder, or in your Documents folder.
# 3. Put its full path here. On Windows, use forward slashes even though Explorer
#    shows backslashes: C:/Users/yourname/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=C:/Users/yourname/serviceAccountKey.json

# ALTERNATIVE METHOD — only use this if you can't save a file (e.g. deploying to
# a host that only accepts env vars). Leave FIREBASE_SERVICE_ACCOUNT_PATH blank
# if you use these instead.
# FIREBASE_PROJECT_ID=your-project-id-here
# FIREBASE_CLIENT_EMAIL=your-service-account-email-here
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Allowed origin for your frontend (React web app), used for CORS.
# Add your Lovable.ai preview/production URL here too, comma separated.
CLIENT_ORIGIN=http://localhost:5173

# From https://openweathermap.org/api — free tier, no credit card needed.
# Powers GET /api/external/weather. Without this, that endpoint returns [].
OPENWEATHER_API_KEY=

# From https://app.text.lk (Sri Lankan SMS gateway — Twilio doesn't operate
# in Sri Lanka). Powers SMS on request-approved / delivery-started /
# delivery-ended / area water-level alerts (see "Real SMS (Text.lk)" in
# CLAUDE.md). Without TEXTLK_API_TOKEN, SMS is silently skipped (logged,
# not an error) — nothing else breaks.
# A custom TEXTLK_SENDER_ID (e.g. your app's name) needs approval in the
# Text.lk dashboard first (Sending tab > Sender ID, a few hours to 3
# business days) — use their shared demo ID "TextLKDemo" until then, it
# works immediately with no approval step.
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=TextLKDemo
