{
  "name": "disaster-aid-server",
  "version": "1.0.0",
  "description": "Backend API for the Centralized Disaster Aid Request, Tracking and Distribution Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "train-flood-model": "node scripts/train-flood-risk-model.js",
    "backup-firestore": "node scripts/backup-firestore.js",
    "evaluate-flood-model": "node scripts/evaluate-flood-model.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:report": "vitest run --reporter=verbose > test-results.txt"
  },
  "dependencies": {
    "@turf/simplify": "^7.3.5",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.10.1",
    "firebase-admin": "^12.1.0",
    "papaparse": "^5.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.0",
    "vitest": "^4.1.11"
  },
  "nodemonConfig": {
    "ignore": [
      "src/data/*.json",
      "backups/*",
      "ml-evaluation-report.*"
    ]
  }
}
