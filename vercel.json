{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": "express"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "crons": [
    { "path": "/api/cron/water-levels", "schedule": "0 6 * * *" },
    { "path": "/api/cron/reservoirs", "schedule": "30 6 * * *" }
  ]
}
