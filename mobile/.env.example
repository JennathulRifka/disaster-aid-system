# Copy to ".env" in mobile/. Expo automatically inlines any var prefixed
# EXPO_PUBLIC_ from this file at build time - no extra config needed.
# Same Firebase project as the web app (Console > Project Settings > General > Your apps).

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCFeOCGBgocBZ7ZBu7lfdjdc-zhKHSZ8p4
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=disaster-aid-system.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=disaster-aid-system
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=disaster-aid-system.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=578755390692
EXPO_PUBLIC_FIREBASE_APP_ID=1:578755390692:web:81a31c04fe9c02dedd90f1

# Your computer's LAN IP (not localhost/127.0.0.1 - a phone on Expo Go can't
# reach "localhost" since that means the phone itself). Find it with
# `ipconfig` (Windows) and look for IPv4 Address on your Wi-Fi adapter.
# Phone and computer must be on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# From Google Cloud Console > APIs & Services > Credentials. Deliberately
# NOT prefixed EXPO_PUBLIC_ - react-native-maps reads this at native build
# time via app.config.js, not from the JS bundle. Restrict this key to your
# Android package name + SHA-1 fingerprint in Cloud Console.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
