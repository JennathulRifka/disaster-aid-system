# Copy to ".env" in your web app's root folder. Add "web-app/.env" to .gitignore.

# From Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# From Google Cloud Console > APIs & Services > Credentials. Powers the
# volunteer turn-by-turn navigation screen (Maps JavaScript API + Directions/
# Routes API). Restrict this key to your site's HTTP referrers in Cloud
# Console so it can't be abused if extracted from the built JS bundle.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Your Express backend URL
VITE_API_URL=http://localhost:5000
